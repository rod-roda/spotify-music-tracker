{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "prisma",
    "dist",
    "prisma.config.ts",
    "src/__tests__",
    "src/**/*.test.ts"
  ]
}