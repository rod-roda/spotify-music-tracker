# PostgreSQL
# Use port 5432 if using local PostgreSQL, or 5433 if using docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musictracker

# Spotify OAuth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3333/auth/callback

# Last.fm
LASTFM_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Application
PORT=3333
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Security (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=
COOKIE_SECRET=

# Redis
REDIS_URL=redis://localhost:6379