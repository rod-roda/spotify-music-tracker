{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://spotify-music-tracker-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/me/:path*",
      "destination": "https://spotify-music-tracker-production.up.railway.app/me/:path*"
    },
    {
      "source": "/health",
      "destination": "https://spotify-music-tracker-production.up.railway.app/health"
    },
    {
      "source": "/callback",
      "destination": "/index.html"
    }
  ]
}
